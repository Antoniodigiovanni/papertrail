# Docker Compose reads .env. The native server uses exported environment variables.
# Values below are public configuration, not credentials. Replace placeholders.
PUBLIC_ORIGIN=https://papers.example.org
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-your-access-application-audience
# Host-side loopback port; the container always listens internally on 3000.
PORT=3000
# Native production defaults to Access authentication. Development must be explicit.
AUTH_MODE=access
HOST=0.0.0.0
DATA_DIR=./data
