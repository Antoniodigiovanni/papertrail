{
  "name": "papertrail",
  "version": "1.0.0",
  "description": "A private, self-hosted paper library and PDF reader",
  "scripts": {
    "dev": "AUTH_MODE=development tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint client server tests scripts vite.config.ts",
    "test": "tsc -p tsconfig.tests.json && node --test --experimental-test-isolation=none dist/tests/tests/*.test.js",
    "test:browser": "npm run build && tsc -p tsconfig.tests.json && node scripts/browser-smoke.mjs",
    "start": "node dist/server/index.js",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:providers": "node scripts/check-providers.mjs",
    "check:import-route": "npm run build && node scripts/check-import-route.mjs",
    "test:browser:library": "npm run build && tsc -p tsconfig.tests.json && PAPERTRAIL_LIBRARY_ONLY=1 node scripts/browser-smoke.mjs"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "2.17.6",
    "saxes": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.8.0",
    "playwright": "1.64.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.2.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.1 <23"
  },
  "overrides": {
    "lightningcss": "1.32.0"
  }
}
